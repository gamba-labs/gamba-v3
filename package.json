{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm run dev:prepare && pnpm run dev:all",
    "dev:prepare": "pnpm --filter @gamba/core build && pnpm --filter @gamba/react build",
    "dev:all": "pnpm --parallel --filter @gamba/core --filter @gamba/react --filter @gamba/explorer --filter @gamba/platform-template --filter @gamba/basic-example dev",
    "dev:apps": "pnpm --parallel --filter @gamba/explorer --filter @gamba/platform-template --filter @gamba/basic-example dev",
    "dev:full": "turbo run dev --cache=local:r,remote:r --continue",
    "dev:packages": "pnpm --parallel --filter @gamba/core --filter @gamba/react dev",
    "clean": "echo '🧹 Cleaning workspace...' && rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist .turbo apps/*/.turbo packages/*/.turbo pnpm-lock.yaml && echo '✨ Clean complete! Run pnpm install to reinstall.'",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "turbo": "^2.8.6",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.29.3+sha512.498e1fb4cca5aa06c1dcf2611e6fafc50972ffe7189998c409e90de74566444298ffe43e6cd2acdc775ba1aa7cc5e092a8b7054c811ba8c5770f84693d33d2dc"
}
